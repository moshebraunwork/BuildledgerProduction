# Supabase — get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — get from https://resend.com/api-keys (for sending invoices + OTP email)
RESEND_API_KEY=re_your_key
INVOICE_FROM_EMAIL=invoices@yourdomain.com

# The support/superadmin email that always has full access
SUPPORT_ADMIN_EMAIL=you@yourdomain.com
