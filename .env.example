# ============================================================
# BuildLedger environment — Neon + Clerk + Cloudflare R2 stack
# ============================================================

# --- Neon (Postgres database) ---
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# --- Clerk (authentication: email OTP; TOTP 2FA on paid plan) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Signing secret for the Clerk webhook (Clerk dashboard -> Webhooks -> your
# endpoint -> Signing Secret). Point the endpoint at /api/webhooks/clerk and
# subscribe to the user.created event so accepted invites sync automatically.
CLERK_WEBHOOK_SECRET=whsec_xxx
# Tell Clerk where the sign-in page lives
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Cloudflare R2 (punch photo storage) ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=buildledger-photos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- Resend (invoice emails) ---
RESEND_API_KEY=re_xxx
INVOICE_FROM_EMAIL=invoices@yourdomain.com

# --- Ask AI (Google Gemini) ---
# Create a key at https://aistudio.google.com/apikey and paste it here.
GEMINI_API_KEY=AIza_xxx
# Optional — override the model (defaults to gemini-2.5-flash). Set this if
# Google retires the default model (the API returns 404 for retired names).
GEMINI_MODEL=gemini-2.5-flash

# --- App ---
# The email that becomes the built-in superadmin on first sign-in
SUPPORT_ADMIN_EMAIL=you@yourdomain.com
NEXT_PUBLIC_APP_URL=https://workstock.mobrauntech.com
